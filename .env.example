# TestForge configuration. Copy to .env, or run ./scripts/init-env.sh to generate
# one with random secrets. Every value below shows its default.

# ── Process ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# api | worker | hybrid (both in one process)
ENGINE_MODE=hybrid
PORT=3000
HOST=0.0.0.0
# Set when behind a reverse proxy/load balancer (e.g. 1, or true)
TRUST_PROXY=false
# Comma-separated origins allowed to call the API from browsers (empty = same-origin only)
CORS_ORIGIN=

# ── Authentication ────────────────────────────────────────────────────────────
# Keys must be >= 16 chars. Users only see their own jobs; admin keys see all
# jobs and can pause/resume/clear the queue. Generate: openssl rand -hex 24
API_AUTH_ENABLED=true
API_KEYS=
ADMIN_API_KEYS=

# ── Rate limiting (per API key, or per IP when unauthenticated) ───────────────
# redis = shared by all API instances; memory = per instance
RATE_LIMIT_STORE=redis
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
SUBMIT_RATE_LIMIT_MAX=60

# ── Redis ─────────────────────────────────────────────────────────────────────
# Either REDIS_URL (redis://user:pass@host:6379/0, rediss:// for TLS) or the fields below.
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
REDIS_KEY_PREFIX=tf

# ── Queue ─────────────────────────────────────────────────────────────────────
QUEUE_NAME=test-execution
# Retries after the first failed attempt (per job, overridable up to QUEUE_MAX_RETRIES)
QUEUE_DEFAULT_RETRIES=0
QUEUE_MAX_RETRIES=5
QUEUE_BACKOFF_DELAY=2000
QUEUE_STALLED_INTERVAL=30000
QUEUE_MAX_STALLED_COUNT=2

# ── Workers ───────────────────────────────────────────────────────────────────
# docker = sandboxed containers (production). local = child processes on the
# host with NO isolation (development only; refused in production unless
# WORKER_ALLOW_UNSAFE_LOCAL=true).
WORKER_EXECUTOR=docker
WORKER_ALLOW_UNSAFE_LOCAL=false
WORKER_CONCURRENCY=4
WORKER_TIMEOUT=300000
SECURITY_MAX_EXECUTION_TIME=1800000
WORKER_KILL_TIMEOUT=5000
SHUTDOWN_TIMEOUT=25000
WORKER_ALLOWED_COMMANDS=node,npm,npx,python,python3,pip,bash,sh,ruby,php,go,java,echo,true,false,sleep

# ── Docker sandbox ────────────────────────────────────────────────────────────
DOCKER_SOCKET=/var/run/docker.sock
# Group id owning the docker socket on the host: stat -c %g /var/run/docker.sock
DOCKER_GID=999
# Optional stronger isolation, e.g. runsc (gVisor) or kata-runtime
DOCKER_RUNTIME=
DOCKER_PULL_POLICY=if-not-present
DOCKER_JOB_USER=65534:65534
WORKER_MAX_MEMORY_MB=512
WORKER_CPUS=1
WORKER_PIDS_LIMIT=256
WORKER_TMPFS_MB=256
WORKER_NETWORK_ENABLED=false
# Override runtime images, e.g. RUNTIME_IMAGE_NODE=node:20-alpine
# RUNTIME_IMAGE_BASH / _SH / _NODE / _PYTHON / _RUBY / _PHP / _GO / _JAVA

# ── Jobs ──────────────────────────────────────────────────────────────────────
JOB_TTL_SECONDS=604800
SECURITY_MAX_SCRIPT_BYTES=100000
MAX_OUTPUT_BYTES=1048576

# ── Quotas (per API key; admin keys are exempt; 0 = unlimited) ───────────────
QUOTA_MAX_ACTIVE_JOBS=100
QUOTA_MAX_JOBS_PER_DAY=0
BATCH_MAX_JOBS=100

# ── Artifacts (files jobs write to $TESTFORGE_ARTIFACTS) ─────────────────────
ARTIFACT_MAX_BYTES=10485760
ARTIFACT_MAX_FILES=50

# ── Webhooks ──────────────────────────────────────────────────────────────────
# HMAC-SHA256 signing secret (X-TestForge-Signature). Strongly recommended.
WEBHOOK_SECRET=
# Admin-configured URLs that receive every job.finished/batch.finished event
WEBHOOK_URLS=
# User-supplied webhook URLs must be https and public unless relaxed here
WEBHOOK_ALLOW_HTTP=false
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WEBHOOK_TIMEOUT=10000
WEBHOOK_MAX_ATTEMPTS=8

# ── Artifact storage ──────────────────────────────────────────────────────────
# redis (default; max 100 MiB per job) or s3 (AWS S3, R2, MinIO, SeaweedFS, …)
ARTIFACT_STORE=redis
S3_BUCKET=
S3_REGION=us-east-1
# Set for non-AWS endpoints, e.g. http://s3:8333 (compose --profile s3)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
S3_PREFIX=testforge
S3_CREATE_BUCKET=false

# ── Long-term job history (Postgres; empty = disabled) ────────────────────────
# docker compose defaults this to its bundled Postgres; set it empty there to disable.
# e.g. postgres://testforge:<password>@db.example.com:5432/testforge
HISTORY_DATABASE_URL=
HISTORY_DATABASE_SSL=false
HISTORY_RETENTION_DAYS=365
# Password for the Postgres bundled with docker compose
POSTGRES_PASSWORD=

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
METRICS_PORT=9100
LOG_LEVEL=info
# json | pretty (default: json in production)
LOG_FORMAT=
LOG_TO_FILE=false
LOG_DIRECTORY=./logs

# ── docker compose only ───────────────────────────────────────────────────────
API_PORT=3000
API_BIND=0.0.0.0
GRAFANA_USER=admin
GRAFANA_PASSWORD=
