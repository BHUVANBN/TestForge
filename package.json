{
  "name": "testforge",
  "version": "2.0.0",
  "description": "Distributed, sandboxed test execution engine: queue scripts, run them in isolated containers, stream results.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:api": "ENGINE_MODE=api node dist/index.js",
    "start:worker": "ENGINE_MODE=worker node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "jest --testPathIgnorePatterns integration",
    "test:coverage": "jest --coverage --testPathIgnorePatterns integration",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "forge": "node dist/cli/forge.js",
    "cli": "ts-node-dev --transpile-only src/cli/forge.ts",
    "docker:build": "docker build -t testforge:latest .",
    "docker:up": "docker compose up -d --build",
    "prepublishOnly": "npm run build",
    "test:integration": "jest test/integration.test.ts --runInBand"
  },
  "bin": {
    "forge": "./dist/cli/forge.js"
  },
  "keywords": [
    "testing",
    "distributed",
    "queue",
    "worker",
    "typescript",
    "nodejs"
  ],
  "author": "TestForge Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.6",
    "bullmq": "^4.15.0",
    "commander": "^14.0.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dockerode": "^4.0.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "joi": "^17.11.0",
    "prom-client": "^15.1.3",
    "socket.io": "^4.8.3",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.4",
    "@types/cors": "^2.8.15",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.7",
    "@types/node": "^20.8.7",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.6",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "ioredis-mock": "^8.13.1",
    "jest": "^29.7.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE",
    ".env.example"
  ]
}
